{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mangwa-serveur",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-07",
  "dev": {
    "port": 8788
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "PUBLIC_SITE_URL": "https://mangwacorpus.com"
  },
  // ADMIN_SECRET : définir via `wrangler secret put ADMIN_SECRET`
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "1da950dfb5cf409bb1ccbf14be88a3e7"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "mangwa-corpus-media"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mangwa-corpus-db",
      "database_id": "52d169a2-fc4f-40a3-959d-128bb2f15d35"
    }
  ],
  "env": {
    "preview": {
      "name": "mangwa-corpus-preview",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mangwa-corpus-db",
          "database_id": "52d169a2-fc4f-40a3-959d-128bb2f15d35"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "mangwa-corpus-media-preview"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "CACHE",
          "id": "1da950dfb5cf409bb1ccbf14be88a3e7"
        }
      ],
      "vars": {
        "PUBLIC_SITE_URL": "https://preview.mangwacorpus.com",
        "PAYPAL_XAF_TO_EUR": "0.00152",
        "PAYPAL_ENV": "sandbox"
      }
    }
  },
  // "ai": {
  //   "binding": "AI"
  // },
  "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": true
    }
  }
}